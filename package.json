{
  "name": "tplink-escp",
  "version": "0.1.0",
  "description": "TypeScript implementation of TP-Link Easy Smart Configuration Protocol",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/mcp-server.ts --format esm,cjs --dts --clean",
    "mcp:start": "node dist/mcp-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tplink",
    "switch",
    "escp",
    "smrt",
    "easy-smart",
    "vlan"
  ],
  "license": "MIT",
  "author": "Jordan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1-TB/TPLinkSwitchLibrary.git"
  },
  "homepage": "https://github.com/1-TB/TPLinkSwitchLibrary#readme",
  "bugs": {
    "url": "https://github.com/1-TB/TPLinkSwitchLibrary/issues"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  }
}
